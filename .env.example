# ─────────────────────────────────────────────────────────────────────────────
# Devnith Portfolio CMS — Environment Configuration
# ─────────────────────────────────────────────────────────────────────────────
#
# INSTRUCTIONS FOR HOSTINGER DEPLOYMENT:
#   1. Copy this file to `.env` in your project root on the server.
#   2. Fill in the values below with your real production settings.
#   3. NEVER commit your real `.env` file to Git.
#
# On Hostinger Node.js hosting, set these via the Hostinger hPanel
# "Environment Variables" section, OR place a .env file in the project root.
# ─────────────────────────────────────────────────────────────────────────────

# Server port (Hostinger sets this automatically — leave as-is unless overriding)
PORT=3000

# Your real public-facing domain (used in console logs and CORS)
# Example: https://www.dnkoralage.com
APP_URL=https://yourdomain.com

# Allowed CORS origin for API requests.
# Set to your domain on production. Use * for local dev only.
# Example: https://www.dnkoralage.com
CORS_ORIGIN=*

# Initial admin username (only used if no admin account exists in DB yet)
ADMIN_INITIAL_USER=admin

# Initial admin password (only used on FIRST startup to seed the DB)
# IMPORTANT: Change this immediately after first login via Admin Dashboard → Security.
# Must be at least 8 characters.
ADMIN_INITIAL_PASSWORD=ChangeThisNow!2026

# ─────────────────────────────────────────────────────────────────────────────
# NOTE: All data is persisted in:  data/db/*.json
#       All uploads are stored in: assets/images/
#       Both directories must have write permissions on the server.
# ─────────────────────────────────────────────────────────────────────────────
